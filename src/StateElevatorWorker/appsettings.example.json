{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMqSettings": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "CHANGE_ME_RABBITMQ_PASSWORD",
    "ServerEventsQueue": "q.state-elevator.server-events",
    "PingEventsQueue": "q.state-elevator.ping-events",
    "StatusEventsExchange": "statusEventsExchange",
    "StatusChangedRoutingKey": "server.status.changed"
  },
  "RedisSettings": {
    "Configuration": "localhost:6379,defaultDatabase=1",
    "KeyPrefix": "state-elevator"
  }
}
